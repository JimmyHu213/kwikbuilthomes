{
  "name": "kwikbuilthomes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "test": "vitest run",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "payload generate:types",
    "payload:bundle-config": "esbuild payload.config.ts --bundle --packages=external --format=esm --platform=node --outfile=.payload-config-compiled.mjs",
    "migrate": "npm run payload:bundle-config && cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=.payload-config-compiled.mjs payload migrate",
    "migrate:create": "npm run payload:bundle-config && cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=.payload-config-compiled.mjs payload migrate:create",
    "migrate:status": "npm run payload:bundle-config && cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_CONFIG_PATH=.payload-config-compiled.mjs payload migrate:status",
    "seed": "esbuild scripts/seed-entry.ts --bundle --packages=external --format=esm --platform=node --alias:@payload-config=./payload.config.ts --outfile=.seed-compiled.mjs && cross-env NODE_OPTIONS=--no-deprecation node .seed-compiled.mjs",
    "ci": "npm run migrate && next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@pascal-app/core": "^0.3.0",
    "@pascal-app/viewer": "^0.3.0",
    "@payloadcms/db-postgres": "^3.79.1",
    "@payloadcms/email-nodemailer": "^3.79.1",
    "@payloadcms/next": "^3.79.1",
    "@payloadcms/richtext-lexical": "^3.79.1",
    "@payloadcms/storage-vercel-blob": "^3.79.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.13.1",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.7",
    "next": "^15.5.14",
    "payload": "^3.79.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.1.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.29.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "sass": "^1.98.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.4",
    "vitest": "^3.2.4"
  }
}
