# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload CMS
src/payload-types.ts
src/app/(payload)/admin/importMap.js

# Planning & docs (internal)
.planning/
docs/

# OpenNext (Cloudflare build output — not needed for Vercel)
.open-next/

# Superpowers plugin (brainstorm sessions, mockups)
.superpowers/

# Cloudflare dev vars
.dev.vars
.env*.local
