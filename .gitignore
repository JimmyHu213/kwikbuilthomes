# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload CMS
src/app/(payload)/admin/importMap.js

# Planning & docs (internal)
.planning/
docs/*
!docs/MIGRATIONS.md

# Bundled Payload config for CLI (generated)
.payload-config-compiled.mjs
.seed-compiled.mjs

# OpenNext (Cloudflare build output — not needed for Vercel)
.open-next/

# Superpowers plugin (brainstorm sessions, mockups)
.superpowers/

# Cloudflare dev vars
.dev.vars
.env*.local

# 本地开发上传文件(无 Blob token 时 Payload 存到这里)。生产用 Vercel Blob。
/media/
/documents/

# Playwright MCP test artifacts
.playwright-mcp/
